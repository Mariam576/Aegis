# Required: free key from Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Optional: leave empty to use DuckDuckGo instead (free, no key)
TAVILY_API_KEY=

# Optional: which Gemini models to use
# Smart model = planning, comparing, writing. Fast model = reading each source.
MODEL_SMART=gemini-3.5-flash
MODEL_FAST=gemini-3.5-flash-lite

# Optional: free-tier pacing
# Requests per minute per model. Lower it if you see rate-limit errors.
GEMINI_RPM=8
# How many requests can run at the same time
GEMINI_CONCURRENCY=2
